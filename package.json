{
  "name": "didit",
  "version": "0.2.0",
  "private": true,
  "description": "Flag weakened tests, assertions, type checks, and CI in local Git changes.",
  "type": "module",
  "bin": {
    "didit": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "schema",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "20.19.43",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "fast-xml-validator": "1.4.2",
    "jsonc-parser": "3.3.1",
    "picomatch": "4.0.7",
    "zod": "4.6.7"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
